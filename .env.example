# SHRI Print Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
SHRI_PORT=4888

# ============================================
# CLOUD SERVER (for production)
# ============================================
# CLOUD_SERVER=https://shri-print-bahadurgarh.yourdomain.com

# ============================================
# PAYMENT PROVIDERS
# ============================================
# Razorpay (optional - for online payments)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ============================================
# DATABASE (Cloudflare D1 - production)
# ============================================
# These are set automatically by Cloudflare Workers
# D1_DATABASE_BINDING=DB
# D1_DATABASE_NAME=shri-print

# ============================================
# FILE STORAGE (Cloudflare R2 - production)
# ============================================
# R2_BUCKET_BINDING=BUCKET
# R2_BUCKET_NAME=shri-print-documents

# ============================================
# DEVELOPMENT OVERRIDES
# ============================================
# Local development uses SQLite and local filesystem
# No additional config needed for local dev

# ============================================
# LOGGING
# ============================================
# LOG_LEVEL=info  # debug, info, warn, error

# ============================================
# AGENT CONFIGURATION
# ============================================
# AGENT_MODE=live  # or dry-run
# AGENT_SERVER=https://shri-print-bahadurgarh.yourdomain.com

# ============================================
# WINDOWS SPECIFIC (for local development)
# ============================================
# SUMATRAPDF_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe
# PRINTER_NAME=EPSON L8050 Series